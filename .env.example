# Copy to .env and adjust. .env is gitignored -- never commit real keys.

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# On the Windows host, native MySQL owns 3306. Set this to 3307 there.
MYSQL_HOST_PORT=3306
MYSQL_ROOT_PASSWORD=hackathon
MYSQL_DATABASE=harness

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=harness

# The agent connects with this account. Create it read-only (see harness/db.py)
# so a hallucinated DROP TABLE cannot end the demo.
DB_USER=harness_ro
DB_PASSWORD=readonly

# Admin account, used only by data loading and tests.
DB_ADMIN_USER=root
DB_ADMIN_PASSWORD=hackathon

# ---------------------------------------------------------------------------
# LLM provider: "local" (llama.cpp on the RTX 4060) or "gemini" (API fallback)
# ---------------------------------------------------------------------------
HARNESS_LLM=local

# -- local: llama.cpp server, OpenAI-compatible endpoint ---------------------
# Launch with:
#   llama-server -m D:\models\Qwen3.5-9B-Q4_K_M.gguf \
#     -ngl 99 -c 32768 --cache-type-k q8_0 --cache-type-v q8_0 \
#     --host 0.0.0.0 --port 8080 --jinja
LOCAL_BASE_URL=http://127.0.0.1:8080/v1
LOCAL_MODEL=qwen3.5-9b
# Qwen3.5 thinks by default. Leave this false for the live demo -- <think>
# blocks read as a hang on stage. Flip to true for the accuracy writeup.
LOCAL_ENABLE_THINKING=false

# -- gemini: API fallback ----------------------------------------------------
# Create the key at https://aistudio.google.com/apikey -- NOT in the Cloud
# console's Credentials page. Since September 2026 the Gemini API rejects the
# legacy "standard" keys that page issues; AI Studio issues service-account-
# bound "auth keys", restricted to the Gemini API by default.
#
# Rate limits are per PROJECT, not per key, and Google no longer publishes
# fixed free-tier numbers -- check your live limits in AI Studio.
#
# Billing note: the $300 Cloud Welcome/free-trial credit does NOT cover Gemini
# API usage for accounts created after 2026-03-02. Free tier needs no billing
# account at all, which is what this project expects.
#
# Model ids move fast. `python -m harness.llm` lists what your key can reach.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# ---------------------------------------------------------------------------
# Agent safety rails
# ---------------------------------------------------------------------------
SQL_TIMEOUT_SECONDS=15
SQL_MAX_ROWS=200
AGENT_MAX_STEPS=12
