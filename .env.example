# Copy to .env and adjust. .env is gitignored -- never commit real keys.

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# On the Windows host, native MySQL owns 3306. Set this to 3307 there.
MYSQL_HOST_PORT=3306
MYSQL_ROOT_PASSWORD=hackathon
MYSQL_DATABASE=harness

# Benchmark selection. For the new milk-tea fixture set BOTH:
# HARNESS_DATASET=milk_tea
# DB_NAME=milk_tea
# Then import: python -m data.milk_tea.load --database milk_tea
HARNESS_DATASET=saas

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=harness

# The agent connects with this account. Create it read-only (see harness/db.py)
# so a hallucinated DROP TABLE cannot end the demo.
DB_USER=harness_ro
DB_PASSWORD=readonly

# Admin account, used only by data loading and tests.
DB_ADMIN_USER=root
DB_ADMIN_PASSWORD=hackathon

# ---------------------------------------------------------------------------
# LLM provider: "local" (llama.cpp on the RTX 4060) or "anthropic" (API
# fallback). "gemini" is FROZEN as of 2026-09-18 -- see below.
# ---------------------------------------------------------------------------
HARNESS_LLM=local

# -- local: llama.cpp server, OpenAI-compatible endpoint ---------------------
# Launch with:
#   llama-server -m D:\models\Qwen3.5-9B-Q4_K_M.gguf \
#     -ngl 99 -c 32768 --cache-type-k q8_0 --cache-type-v q8_0 \
#     --host 0.0.0.0 --port 8080 --jinja
LOCAL_BASE_URL=http://127.0.0.1:8080/v1
LOCAL_MODEL=qwen3.5-9b
# Qwen3.5 thinks by default. Leave this false for the live demo -- <think>
# blocks read as a hang on stage. Flip to true for the accuracy writeup.
LOCAL_ENABLE_THINKING=false

# -- anthropic: API fallback -------------------------------------------------
# Used when the GPU path will not come up. Haiku 4.5 is the default: cheapest,
# fastest, and a fair stand-in for the 9B we ship on.
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-haiku-4-5

# -- gemini: FROZEN 2026-09-18 -----------------------------------------------
# Out of scope after a Google API policy change. The adapter is still in
# harness/llm.py but HARNESS_LLM=gemini now refuses to start; leave these
# unset. To thaw it deliberately, set GEMINI_UNFREEZE=true as well -- and
# re-read the terms first, since that is why it was frozen.
#
# Kept for whoever thaws it: create the key at https://aistudio.google.com/apikey,
# NOT in the Cloud console's Credentials page (legacy "standard" keys are
# rejected). Rate limits are per PROJECT, not per key. The $300 Cloud Welcome
# credit does NOT cover Gemini API usage for accounts created after 2026-03-02.
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.8-flash
# GEMINI_UNFREEZE=false

# ---------------------------------------------------------------------------
# Agent safety rails
# ---------------------------------------------------------------------------
SQL_TIMEOUT_SECONDS=15
SQL_MAX_ROWS=200
AGENT_MAX_STEPS=12
